<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Graphics\Shaders\Bullet.frag" />
    <None Remove="Graphics\Shaders\Bullet.vert" />
    <None Remove="Graphics\Shaders\SimpleShape.frag" />
    <None Remove="Graphics\Shaders\SimpleShape.vert" />
    <None Remove="Graphics\Shaders\SimpleTexture.frag" />
    <None Remove="Graphics\Shaders\SimpleTexture.vert" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Graphics\Shaders\Bullet.frag" />
    <EmbeddedResource Include="Graphics\Shaders\Bullet.vert" />
    <EmbeddedResource Include="Graphics\Shaders\SimpleShape.frag" />
    <EmbeddedResource Include="Graphics\Shaders\SimpleShape.vert" />
    <EmbeddedResource Include="Graphics\Shaders\SimpleTexture.frag" />
    <EmbeddedResource Include="Graphics\Shaders\SimpleTexture.vert" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Audio\" />
    <Folder Include="Collision\" />
    <Folder Include="Graphics\Text\" />
    <Folder Include="Graphics\Video\" />
    <Folder Include="Math\" />
    <Folder Include="UI\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

</Project>
